# Copy to backend/.env.local and fill in (local development). Production: .env.cyoa-f15a9 + Secret Manager.

# Firebase Admin service account key (already placed at backend/serviceAccountKey.json)
SERVICE_ACCOUNT_FILE=serviceAccountKey.json

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must include: http://localhost:8000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# SMTP for reminder emails. Leave SMTP_HOST empty to just log emails to the console.
# Gmail example: smtp.gmail.com / 587 / your address / a Google "App password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

ENABLE_SCHEDULER=true
