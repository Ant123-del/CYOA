# Copy to backend/.env.local and fill in (local development). Production: .env.cyoa-f15a9 + Secret Manager.

# Firebase Admin service account key (already placed at backend/serviceAccountKey.json)
SERVICE_ACCOUNT_FILE=serviceAccountKey.json

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# AI: Gemini is used when GEMINI_API_KEY is set (https://aistudio.google.com/apikey), otherwise Claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# SMTP for reminder emails. Leave SMTP_HOST empty to just log emails to the console.
# Gmail: smtp.gmail.com / 587 / your Gmail address / a 16-character Google App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

ENABLE_SCHEDULER=true
