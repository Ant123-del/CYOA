# Production (non-secret) config for Cloud Functions - the Firebase CLI deploys this file
# as environment variables. Secrets (GEMINI_API_KEY, ANTHROPIC_API_KEY, SMTP_PASSWORD = Gmail App Password)
# live in Secret Manager instead; deploy.sh copies them there from .env.local.

# Your Vercel URL (comma-separate extra origins, e.g. a custom domain). The first is used in email links.
FRONTEND_URL=https://cyoa-seven.vercel.app

# Users share their Google Calendar with this address
CALENDAR_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@cyoa-f15a9.iam.gserviceaccount.com

GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
ANTHROPIC_MODEL=claude-opus-5-5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=steveminecraft610@gmail.com
SMTP_FROM="CYOA <steveminecraft610@gmail.com>"
SMTP_USE_TLS=true

# The scheduled `send_reminders` function replaces the in-process scheduler.
ENABLE_SCHEDULER=false
