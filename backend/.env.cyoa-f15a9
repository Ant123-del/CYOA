# Production (non-secret) config for Cloud Functions - the Firebase CLI deploys this file
# as environment variables. Secrets (ANTHROPIC_API_KEY, GOOGLE_CLIENT_SECRET, SMTP_PASSWORD)
# live in Secret Manager instead; deploy.sh copies them there from .env.local.

# Your Vercel URL (comma-separate extra origins, e.g. a custom domain). The first is used in email links.
FRONTEND_URL=https://cyoa.vercel.app

# The deployed `api` function
BACKEND_URL=https://us-central1-cyoa-f15a9.cloudfunctions.net/api

GOOGLE_CLIENT_ID=
ANTHROPIC_MODEL=claude-opus-5-5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_USE_TLS=true

# The scheduled `send_reminders` function replaces the in-process scheduler.
ENABLE_SCHEDULER=false
